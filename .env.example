# ─── Base de datos ────────────────────────────────────────────────────────────
# Postgres (Neon, Supabase, Railway, Render, o local)
DATABASE_URL=postgres://usuario:password@host:5432/mala_vida
# Poner en "true" si el proveedor exige SSL (Neon, Supabase, Render externo)
DATABASE_SSL=false

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Orígenes permitidos para el frontend, separados por coma. "*" permite todos.
CORS_ORIGIN=http://localhost:5173

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Firma de los JWT de jugador. Cambiar por algo largo y aleatorio.
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Clave para entrar al panel de administración (/admin)
ADMIN_KEY=cambia-esta-clave-admin

# ─── Negocio ──────────────────────────────────────────────────────────────────
# Número de WhatsApp del restaurante (solo dígitos, con indicativo)
WHATSAPP_NUMBER=573134966423
# Zona horaria que define cuándo empieza y termina "el día"
TIMEZONE=America/Bogota
# Segundos que dura una partida (debe coincidir con el frontend)
GAME_DURATION_SECONDS=45
# Horas de validez de un premio antes de vencer
REWARD_VALID_HOURS=48
# Partidas permitidas por jugador por día
GAMES_PER_DAY=1

# ─── Compartir el link ────────────────────────────────────────────────────────
# URL pública final del juego. Se usa AL COMPILAR para que la vista previa del
# link en WhatsApp muestre el logo. Ej: https://juega.malavida.co
VITE_PUBLIC_URL=
